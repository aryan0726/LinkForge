# LinkForge backend — environment configuration
#
# Copy to `.env` and fill in real values, then export them before starting the
# application (or let your deployment platform inject them).
#
#   set -a && source .env && set +a      # bash / zsh
#
# NEVER commit a populated .env file. `.env` is gitignored; `.env.example` is not.

# ---------------------------------------------------------------------------
# Required — the application will NOT start if JWT_SECRET is missing when the
# `dev` profile is inactive.
# ---------------------------------------------------------------------------

# Signing key for JWTs. Must be at least 32 bytes for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

DB_URL=jdbc:postgresql://localhost:5433/linkforge
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Externally reachable origin, used to build returned short URLs.
# Development:  http://localhost:8080
# Production:   https://linkforge.example.com
APP_BASE_URL=http://localhost:8080

SERVER_PORT=8080

# Comma-separated list of browser origins allowed to call the API.
# Development:  http://localhost:5173
# Production:   https://linkforge.example.com,https://www.linkforge.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

JWT_EXPIRATION_MS=86400000

# Log levels: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=WARN
