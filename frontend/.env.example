# LinkForge frontend — environment configuration
#
# Copy this file to `.env.local` and adjust as needed.
# Only variables prefixed with VITE_ are exposed to the client bundle.
# Never put secrets in this file — anything here is readable by every visitor.

# Base URL of the Spring Boot API, including the /api prefix.
#
# Local development (backend running on port 8080):
VITE_API_BASE_URL=http://localhost:8080/api
#
# Deployed behind the bundled nginx reverse proxy (same origin):
# VITE_API_BASE_URL=/api
#
# Deployed against a separate API host:
# VITE_API_BASE_URL=https://api.linkforge.example.com/api
